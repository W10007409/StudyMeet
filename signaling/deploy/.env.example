# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore 에 있다.
# 자격증명을 커밋하지 않는다.

# TURN 장기 자격증명. 스파이크 전용으로 새로 만들고 재사용하지 않는다.
# 값 생성 예: openssl rand -base64 24
TURN_USER=studymeet
TURN_PASS=

# realm 은 인증 도메인 문자열이다. 실제 DNS 이름일 필요는 없지만 도메인을 그대로 쓰면 헷갈리지 않는다.
TURN_REALM=studymeet.local

# VM 의 공인 IP 와, 인터페이스에 실제로 붙어 있는 사설 IP.
# AWS/GCP 처럼 1:1 NAT 인 환경에서는 두 값이 다르다. `ip -4 addr` 로 사설 IP 를 확인한다.
# 두 값이 같은 환경(공인 IP 가 인터페이스에 직접 붙은 경우)이면 똑같이 적는다.
PUBLIC_IP=
PRIVATE_IP=

# 인증서 경로는 환경변수로 받지 않는다. certbot 을 --cert-name studymeet 로 발급하므로
# 항상 /etc/letsencrypt/live/studymeet 이고, turnserver.conf 와 nginx.conf 에 고정되어 있다.
