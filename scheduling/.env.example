# 실제 값은 .env 에 둔다. .env 는 커밋하지 않는다.
DATABASE_URL=postgresql://studymeet:studymeet@localhost:5432/studymeet
PORT=3000
# teacher-web(Vite 개발 서버) 을 허용할 origin. 기본값은 로컬 개발용이다 —
# 운영 환경에서는 반드시 실제 프런트엔드 도메인으로 설정해야 한다.
CORS_ORIGIN=http://localhost:5173
# 운영자 API(/operator/*) 시크릿 헤더 X-Operator-Secret 의 기대값. 이것은 인증이 아니다
# (설계 §2.1) — 값이 없으면 서버가 아예 시작되지 않는다. 실제 값은 추측 불가능한 긴
# 무작위 문자열로 바꾼다. 커밋하지 않는다.
OPERATOR_SECRET=replace-with-a-long-random-secret-never-commit-real-value
# 서버가 바인딩할 주소. 기본값은 127.0.0.1(loopback) — 외부 인터페이스에 여는 것은
# 명시적 선택이어야 한다(설계 §2.1). 정말 필요할 때만 바꾼다.
HOST=127.0.0.1
