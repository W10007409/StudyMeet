# 실제 값은 .env.local 에 둔다. .env.local 은 커밋하지 않는다.
#
# VITE_API_BASE 를 비워두면 App.tsx 가 createStubApi() 를 쓴다 — 백엔드 없이 화면만 확인할 때.
# 값을 채우면 createHttpApi(baseUrl) 로 scheduling 백엔드(Fastify)에 직접 붙는다.
# 라우트에 /api 접두사가 없으므로 baseUrl 은 서버 origin 그대로 준다 (기본 PORT=3000).
VITE_API_BASE=http://localhost:3000
# HTTP 모드에서만 쓴다: TeacherApi.listSessions(date) 에는 teacherId 가 없지만
# 실제 라우트(GET /teacher/:id/sessions)는 필요로 한다 — 편성 시스템이 붙기 전까지 여기로 메운다.
VITE_TEACHER_ID=

VITE_SIGNALING_URL=ws://localhost:8080
# TURN 은 선택. 없으면 STUN 만 쓴다.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
