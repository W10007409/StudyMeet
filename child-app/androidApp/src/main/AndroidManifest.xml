<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 필수 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        화면 공유 (MediaProjection)

        android.permission.CAPTURE_VIDEO_OUTPUT 은 여기에 선언하지 않는다.
        해당 권한은 protectionLevel="signature|privileged" 라서 플랫폼 서명 키로 서명됐거나
        /system/priv-app 에 설치된 앱만 받을 수 있다. 일반 배포 앱이 선언하면 조용히 무시되며,
        절대 부여되지 않는다. 일반 앱의 화면 캡처 경로는 MediaProjection 뿐이고
        이 API 는 권한이 아니라 사용자 동의 다이얼로그로 접근을 통제한다.

        MediaProjection 이 실제로 요구하는 것은 아래 두 가지다.
    -->
    <!-- Android 9(P)+ : 포그라운드 서비스 없이는 캡처를 유지할 수 없다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14(UDC)+ : 포그라운드 서비스 타입별 권한이 분리됐다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13(TIRAMISU)+ : 캡처 중임을 알리는 알림을 띄우기 위해 필요 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 선생님 카메라 오버레이 (앱 위에 앱 그리기) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+ : specialUse 포그라운드 서비스 타입 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- PiP 지원 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- FCM 권한 -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <permission
        android:name="com.studymeet.child.permission.C2D_MESSAGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.studymeet.child.permission.C2D_MESSAGE" />

    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChildApp"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            화면 공유 포그라운드 서비스.
            foregroundServiceType 이 없으면 Android 10+ 에서 getMediaProjection() 이
            SecurityException 을 던진다.
        -->
        <service
            android:name=".video.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 선생님 카메라 오버레이 서비스 -->
        <service
            android:name=".TeacherOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 판서 오버레이 서비스 -->
        <service
            android:name=".DrawingOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- 원격 터치 접근성 서비스 -->
        <service
            android:name=".accessibility.RemoteTouchAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FCM 메시징 서비스 -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
