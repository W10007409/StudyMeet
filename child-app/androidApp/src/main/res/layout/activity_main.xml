<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <!-- 로컬 카메라 (숨김 - 프레임 캡처용) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/local_preview"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- 원격 비디오 (위치 예약) -->
    <FrameLayout
        android:id="@+id/remote_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 방 입장 전 UI -->
    <LinearLayout
        android:id="@+id/entry_ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#F0F4FF">

        <!-- 앱 아이콘 영역 -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_marginBottom="16dp"
            android:contentDescription="앱 아이콘" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyMeet"
            android:textColor="#2D3436"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선생님과 함께 공부해요"
            android:textColor="#636E72"
            android:textSize="16sp"
            android:layout_marginBottom="48dp" />

        <!-- 방 코드 입력 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수업 코드"
                    android:textColor="#2D3436"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/room_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/edit_text_bg"
                    android:hint="수업 코드를 입력하세요"
                    android:textColorHint="#B2BEC3"
                    android:textColor="#2D3436"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <Button
                    android:id="@+id/join_room_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="수업 시작하기"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_bg"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 통화 중 제어 UI (숨김 - 오버레이에 통화종료 버튼이 있음) -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/end_call_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="통화 종료"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
