# 실제 값은 .env.local 에 둔다. .env.local 은 커밋하지 않는다.
#
# scheduling 백엔드 origin. 기본 PORT=3000, HOST=127.0.0.1 (설계 §2.1) — 운영자 API 는
# loopback 에만 열려 있다. 이 화면의 개발 서버도 로컬에서 그 서버로 직접 붙는다.
VITE_API_BASE=http://localhost:3000

# 운영자 라우트(/operator/*)가 요구하는 시크릿 헤더(X-Operator-Secret)의 값.
# scheduling/.env 의 OPERATOR_SECRET 과 같은 값을 넣는다.
#
# 주의 — 이것은 인증이 아니다: VITE_ 접두사가 붙은 값은 빌드 결과물(브라우저로 그대로
# 내려가는 JS 번들)에 평문으로 박힌다. 이 시크릿을 아는 사람은 전체 아동의 보호자
# 정보에 닿는 운영자 API 를 그대로 쓸 수 있다. 자세한 내용은 admin-web/README.md 를 읽는다.
VITE_OPERATOR_SECRET=
